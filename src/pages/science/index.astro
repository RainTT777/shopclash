---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { scienceArticles } from '../../lib/science-articles';
---
<BaseLayout title="科学上网深度教程" description="科学上网客户端配置、机场线路、协议测评、流媒体解锁与故障排查深度文章。"><div class="shell section science-library"><Breadcrumbs items={[{label:'首页',href:'/'},{label:'科学上网'}]}/><header><p class="eyebrow">CLASHSHOP DEEP GUIDES</p><h1>科学上网</h1><p>围绕机场线路、Clash 客户端、移动端配置、流媒体解锁、跨境业务和常见故障，提供可执行的深度解析。</p></header><div class="science-grid">{scienceArticles.map((article,index)=><article class="science-card"><span>{String(index+1).padStart(2,'0')} · {article.category}</span><h2><a href={`/science/${article.slug}/`}>{article.title}</a></h2><p>{article.summary}</p><footer><b>深度解析</b><i>含独立 FAQ</i></footer></article>)}</div></div></BaseLayout>
<style>.science-library header{max-width:820px;margin-bottom:32px}.science-library h1{margin:.35rem 0;font-size:3rem}.science-library header>p:last-child{color:#556672;font-size:1.08rem}.science-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.science-card{border:1px solid #d5e0e5;border-radius:18px;padding:24px;background:#f8fafbd9;box-shadow:0 10px 28px #2947560c}.science-card>span{color:#007fa8;font-size:.72rem;font-weight:800}.science-card h2{margin:8px 0;font-size:1.25rem;line-height:1.45}.science-card h2 a{text-decoration:none}.science-card p{color:#52636e;font-size:.88rem}.science-card footer{display:flex;justify-content:space-between;border-top:1px solid #e0e8ec;padding-top:13px;color:#6c7d86;font-size:.72rem}.science-card footer b{color:#007fa8}@media(max-width:700px){.science-grid{grid-template-columns:1fr}.science-library h1{font-size:2.35rem}}</style>
