---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import { site } from '../lib/site';

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'comparisons'>;
  section: string;
  sectionHref: string;
}
const { entry, section, sectionHref } = Astro.props;
const author = await getEntry(entry.data.author);
const reviewer = entry.data.reviewer ? await getEntry(entry.data.reviewer) : undefined;
const title = entry.data.title;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: title,
  description: entry.data.seo.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt || entry.data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: author?.data.name },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: new URL(Astro.url.pathname, site.url).href,
  inLanguage: 'zh-CN'
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: site.url },
    { '@type': 'ListItem', position: 2, name: section, item: new URL(sectionHref, site.url).href },
    { '@type': 'ListItem', position: 3, name: title }
  ]
}];
---
<BaseLayout title={entry.data.seo.title || title} description={entry.data.seo.description} type="article" noindex={entry.data.seo.noindex} jsonLd={jsonLd}>
  <article class="shell section">
    <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: section, href: sectionHref }, { label: title }]} />
    <header class="max-w-3xl">
      <p class="eyebrow">{section}</p>
      <h1 class="my-3 text-4xl leading-tight font-black sm:text-5xl">{title}</h1>
      <p class="text-lg text-muted">{entry.data.summary}</p>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
        <span>作者：{author?.data.name}</span>
        {reviewer && <span>审校：{reviewer.data.name}</span>}
        <time datetime={entry.data.publishedAt.toISOString()}>发布：{entry.data.publishedAt.toLocaleDateString('zh-CN')}</time>
        <time datetime={entry.data.lastVerifiedAt.toISOString()}>核验：{entry.data.lastVerifiedAt.toLocaleDateString('zh-CN')}</time>
      </div>
    </header>
    <div class="prose mt-10"><slot /></div>
    {entry.data.sources.length > 0 && <aside class="prose mt-12 border-t border-line pt-6"><h2 class="text-xl">引用与证据来源</h2><ol>{entry.data.sources.map((source) => <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.title}</a>，{source.publisher}（访问于 {source.accessedAt.toLocaleDateString('zh-CN')}）</li>)}</ol></aside>}
  </article>
</BaseLayout>
