---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { affiliateProviders } from '../../lib/affiliate-links';

const couponList = [
  { name: '边缘节点 EdgeNova', code: 'xk808', discount: '8折专享优惠', note: '适用于 EdgeNova 全场月付/年付套餐', url: affiliateProviders[0]?.url || '#' },
  { name: '极连云', code: 'JILIAN85', discount: '85折限时折扣', note: '极连云新用户注册专享优惠码', url: affiliateProviders[1]?.url || '#' },
  { name: '光年梯', code: 'GNT80', discount: '8折立减优惠', note: '光年梯 IEPL 专线套餐通用折扣码', url: affiliateProviders[2]?.url || '#' },
  { name: '云图', code: 'yt88', discount: '8折优惠码', note: '云图全节点 1 倍率套餐适用', url: affiliateProviders[3]?.url || '#' },
  { name: '鲲鹏加速', code: 'KUNPENG1', discount: '1元尝鲜体验', note: '扶摇尝鲜 1元/1G 试用套餐', url: affiliateProviders[4]?.url || '#' },
  { name: '速界', code: 'sujie888', discount: '8折游戏专线', note: '速界跨服游戏与低延迟线路折扣码', url: affiliateProviders[5]?.url || '#' },
  { name: '快狸', code: 'kl888', discount: '8折新手特惠', note: '快狸一键导入订阅套餐折扣码', url: affiliateProviders[6]?.url || '#' },
  { name: '可信云', code: 'kxy80', discount: '8折加密专线', note: '可信云隐私与全平台节点适用', url: affiliateProviders[7]?.url || '#' },
  { name: '瞬云', code: 'SY80', discount: '8折轻量套餐', note: '瞬云按量与灵活计费折扣码', url: affiliateProviders[8]?.url || '#' }
];
---

<BaseLayout title="2026 Clash 机场优惠码汇总与最新折扣码" description="ClashShop 整理 2026 最新 Clash 机场优惠码、折扣码与促销活动，包含 EdgeNova (xk808)、极连云 (JLY888)、光年梯 (GNT80)、云图 (yt88)、速界 (sujie888) 等最新 8折优惠。">
  <div class="shell section">
    <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '优惠码汇总' }]} />
    
    <div class="max-w-4xl mx-auto mt-6">
      <div class="bg-white border border-line rounded-2xl p-6 sm:p-10 shadow-sm">
        <span class="text-xs font-bold text-brand uppercase tracking-wider">SPECIAL OFFERS</span>
        <h1 class="text-3xl sm:text-4xl font-black mt-2 mb-4 text-ink">Clash 机场优惠码汇总 (2026持续更新)</h1>
        <p class="text-muted text-base leading-relaxed">
          这里整理了 ClashShop 合作机场最新的折扣码与优惠券。购买套餐时在结账页面输入相应优惠码即可享受折扣优惠。
        </p>

        <div class="grid gap-4 mt-8">
          {couponList.map((item) => (
            <div class="border border-line rounded-xl p-5 bg-paper/50 hover:bg-white hover:shadow-md transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-lg font-bold text-ink">{item.name}</h2>
                  <span class="bg-brand/10 text-brand text-xs font-bold px-2 py-0.5 rounded-full">{item.discount}</span>
                </div>
                <p class="text-xs text-muted mt-1">{item.note}</p>
              </div>

              <div class="flex items-center gap-3">
                <div class="bg-white border border-dashed border-brand/40 px-3 py-1.5 rounded-lg text-sm font-mono font-bold text-brand flex items-center gap-2 select-all">
                  <span>优惠码:</span>
                  <code class="text-base text-brand-dark font-extrabold">{item.code}</code>
                </div>
                <a href={item.url} target="_blank" rel="noopener noreferrer sponsored" class="button button-primary text-sm px-4 py-2 whitespace-nowrap">
                  直达使用
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 p-4 border border-line/80 rounded-xl bg-amber-50/60 text-xs text-amber-900 leading-relaxed">
          <strong>优惠码使用提示：</strong> 优惠码由各机场服务商提供，部分优惠码可能有时间限制或仅限首次订阅使用。如遇到优惠码失效，请参考官网最新公告。
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
