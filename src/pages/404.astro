---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="请求的页面不存在或已经移动。" noindex><div class="shell grid min-h-[58vh] place-items-center py-16 text-center"><div><p class="eyebrow">404</p><h1 class="text-4xl font-black">页面没有找到</h1><p class="text-muted">链接可能已经变化，也可能输入有误。</p><div class="mt-6"><a class="button" href="/">返回首页</a></div></div></div></BaseLayout>
