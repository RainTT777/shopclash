---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
export async function getStaticPaths(){return (await getCollection('authors')).map((entry)=>({params:{slug:entry.id},props:{entry}}));}
interface Props { entry: CollectionEntry<'authors'> }
const {entry}=Astro.props; const {Content}=await render(entry);
---
<BaseLayout title={entry.data.name} description={entry.data.bio}><article class="shell section"><Breadcrumbs items={[{label:'首页',href:'/'},{label:'作者'},{label:entry.data.name}]}/><header class="max-w-3xl"><p class="eyebrow">{entry.data.role}</p><h1 class="text-4xl font-black sm:text-5xl">{entry.data.name}</h1><p class="text-lg text-muted">{entry.data.bio}</p></header><div class="prose mt-8"><h2>专业领域</h2><ul>{entry.data.expertise.map((item)=><li>{item}</li>)}</ul>{entry.data.disclosure&&<><h2>利益披露</h2><p>{entry.data.disclosure}</p></>}<Content /></div></article></BaseLayout>
