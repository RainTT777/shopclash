---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const groups = [
  {title:'基础概念',items:[
    ['机场、节点和订阅分别是什么？','机场通常指提供多个代理节点与订阅管理的服务；节点是具体服务器或出口；订阅则是客户端定期获取节点和策略的地址。订阅链接通常包含授权信息，不应公开。'],
    ['代理、VPN 与加速器有什么区别？','三者都可能改变网络路径，但接管范围、协议、使用目的和实现方式不同。选用前应了解客户端实际接管哪些流量，不要只根据产品名称判断。'],
    ['直连、中转和专线分别适合谁？','直连结构简单但受公网波动影响；中转通过国内入口优化接入；专线更重视跨境承载稳定性。浏览、视频、游戏和业务账号对线路要求不同。'],
    ['延迟低为什么网页仍然很慢？','延迟只反映往返响应时间。吞吐、丢包、DNS、服务器负载和目标网站限制都会影响网页速度，必须结合真实任务测试。'],
    ['节点数量越多越好吗？','不一定。大量重复或低质量节点没有实际价值。地区覆盖、稳定性、负载、维护效率和常用出口质量通常比节点总数更重要。'],
    ['什么是流量倍率？','倍率决定实际流量如何从套餐中扣除。2 倍节点使用 1GB 可能扣除 2GB，应按常用节点倍率计算真实可用量。']
  ]},
  {title:'购买、套餐与付款',items:[
    ['第一次购买应该选月付还是年付？','新用户优先月付或最低档短周期，连续测试线路、客户端和客服后再考虑长周期。年付折扣会增加停运和质量变化风险。'],
    ['按量付费适合哪些人？','适合使用频率低、流量波动大或需要备用线路的人。购买前确认流量有效期、倍率、最低充值和余额退款规则。'],
    ['不限时流量是否真的永久有效？','不一定。不按月清零仍可能存在账户有效期、产品下架或服务停止风险，应以当前条款为准。'],
    ['优惠码无法使用有哪些原因？','可能仅限新用户、指定套餐或活动期，也可能不能与余额、折扣套餐叠加。提交订单前核对最终实付和续费价格。'],
    ['如何判断套餐是否性价比高？','比较有效流量、常用节点倍率、设备限制、晚高峰体验、退款条款和售后，而不是只用月费除以标称流量。'],
    ['为什么不建议购买终身套餐？','网络服务存在持续带宽和运维成本，“终身”缺乏明确期限和履约保障。低价终身方案尤其容易把长期风险转给用户。'],
    ['付款前要保存哪些证据？','保存套餐说明、流量和期限、退款条款、订单号、收款主体和付款凭证。网页内容可能变化，仅保存支付截图通常不够。'],
    ['自动续费如何关闭？','先在服务后台关闭，再检查支付宝、微信、银行卡或应用商店的免密与订阅管理。保留关闭成功页面，避免只删除客户端。']
  ]},
  {title:'线路、协议与 IP',items:[
    ['IPLC 与 IEPL 有什么区别？','市场命名经常混用，两者通常代表不同的跨境专线或企业网络产品。普通用户应关注实际拓扑、入口、出口、倍率和高峰表现。'],
    ['BGP 入口有什么作用？','BGP 入口可以根据运营商和路由条件选择接入路径，但不能消除全部拥塞。仍需在自己的移动、联通或电信网络上测试。'],
    ['VLESS Reality 是专线吗？','不是。Reality 属于协议和握手方案，专线描述的是网络承载。协议先进并不能自动改善服务器负载或线路带宽。'],
    ['AnyTLS 一定比传统协议快吗？','不一定。体验取决于实现版本、服务器、网络、拥塞控制和客户端兼容。应在相同线路与时段进行对照测试。'],
    ['什么是原生 IP？','通常指 IP 注册地区和实际使用地区相对一致，但不同检测数据库可能给出不同结果。原生标签也不等于住宅、独享或永久流媒体解锁。'],
    ['广播 IP 会影响使用吗？','可能影响地区识别、流媒体和账号风控，但普通网页访问未必有明显差异。应按目标应用验证，而不是只看标签。'],
    ['共享 IP 和独享 IP 怎么选？','普通浏览和视频通常可用共享 IP；跨境店铺、广告和长期账号环境更重视固定、独享和来源明确的出口。'],
    ['如何判断节点是否超售？','观察多个晚高峰的持续带宽、抖动、丢包和失败率。凌晨峰值很高、晚间长期下降，是负载或入口拥塞的常见信号。']
  ]},
  {title:'客户端与订阅配置',items:[
    ['Clash Verge Rev 如何导入订阅？','在订阅或配置页面新增服务商提供的 Clash/Mihomo 地址，更新后选择配置，再开启系统代理。首次测试时先不要开启 TUN。'],
    ['Shadowrocket 如何扫码导入？','使用应用内扫码入口，核对二维码解析出的域名，再保存并手动更新。扫码成功不代表节点已经启用。'],
    ['v2rayNG 更新后为什么没有节点？','常见原因是订阅过期、格式不兼容、链接复制不完整或服务端返回登录页。先在浏览器确认地址可访问，再查看更新日志。'],
    ['Sing-box 能直接使用 Clash 订阅吗？','通常不能直接等价使用。两者配置结构不同，应使用服务商提供的对应格式或可信的本地转换方式。'],
    ['Mihomo Party 与 Clash Verge 怎么选？','两者都可使用 Mihomo 内核，但界面、配置管理和系统集成不同。选择更适合自己系统和排错习惯的客户端即可。'],
    ['规则模式和全局模式有什么区别？','全局模式让全部流量经过代理，适合短期排错；规则模式按域名和 IP 分流，更适合日常使用，但需要维护规则和 DNS。'],
    ['系统代理与 TUN 有什么区别？','系统代理只影响遵循代理设置的程序；TUN 通过虚拟网卡接管更多流量，适合游戏和命令行，但更容易出现驱动与 DNS 冲突。'],
    ['订阅多久更新一次合适？','多数情况下每天一次足够。更新过于频繁可能触发限制；手动修改配置前应保存可恢复版本。']
  ]},
  {title:'连接故障排查',items:[
    ['所有节点突然超时应该先做什么？','先关闭代理确认基础网络，再同步系统时间、检查订阅到期情况，并用手机热点测试。这样可快速区分宽带、客户端和服务端问题。'],
    ['为什么手机能用但电脑不能用？','可能是电脑防火墙、系统代理、DNS、内核权限或端口冲突。使用同一节点和同一网络对比，再查看电脑客户端日志。'],
    ['开启 TUN 后完全无法上网怎么办？','关闭 TUN 恢复网络，退出其他 VPN 和加速器，检查虚拟网卡、管理员权限、默认路由和 DNS，再逐项重新开启。'],
    ['出现 EOF 或 connection reset 是什么原因？','表示连接被提前关闭，可能来自服务器、TLS 握手、防火墙、协议参数或网络干扰。结合发生阶段和日志上下文判断。'],
    ['能打开 IP 地址但打不开域名怎么办？','通常优先检查 DNS。恢复客户端默认 DNS，关闭浏览器安全 DNS做对照，并确认规则没有把解析请求错误分流。'],
    ['订阅更新失败但旧节点还能用怎么办？','说明节点连接和订阅请求是两条路径。检查订阅域名、链接有效期和“通过代理更新”设置，不要立即删除仍可用的旧配置。'],
    ['为什么节点延迟正常却无法访问网站？','延迟测试可能只检测端口。还要验证 TLS、DNS、出口 IP、规则策略和目标网站地区限制。'],
    ['怎样向客服提供有效信息？','提供系统、客户端和内核版本、测试时间、失败节点、网络运营商、脱敏日志和已完成步骤，切勿发送完整订阅链接或密钥。']
  ]},
  {title:'视频、流媒体与 AI',items:[
    ['看 YouTube 4K 需要多少速度？','实际需求随编码和内容变化。比起固定门槛，更应观察 Stats for Nerds 中的连接速度、缓冲区和自动降档。'],
    ['测速很快为什么视频仍然缓冲？','测速服务器与视频 CDN 不同，节点可能对测速有高带宽，但到目标 CDN 的路由拥塞或丢包较高。'],
    ['Netflix 只能看自制内容是什么原因？','通常表示出口 IP 被识别为代理或所在区授权受限。更换同地区解锁出口并清理 DNS 缓存后重试。'],
    ['原生 IP 一定能解锁流媒体吗？','不一定。平台会动态更新数据库，且原生、住宅和独享是不同属性。必须逐个平台实际测试。'],
    ['ChatGPT 提示 Access Denied 怎么办？','确认出口位于支持地区，保持 IP 与时区稳定，清理目标站点 Cookie 或用干净浏览器档案测试，避免连续切换大量国家。'],
    ['Claude 能打开首页但无法登录怎么办？','检查账号地区、Cookie、浏览器扩展、出口风险和服务状态。网页可访问不等于账户或全部功能可用。'],
    ['频繁切换 AI 节点会影响账号吗？','可能增加异常登录信号。长期账号更适合固定少量支持地区出口，并启用多因素认证和恢复方式。'],
    ['如何同时兼顾解锁与速度？','先筛选能解锁目标服务的节点，再在这些节点中比较晚高峰持续吞吐。不要反过来只按峰值速度选择。']
  ]},
  {title:'账号、安全与隐私',items:[
    ['订阅链接泄露有什么风险？','他人可能消耗流量、查看节点或触发设备限制。发现泄露后应在服务后台重置订阅，并更新所有设备。'],
    ['可以把订阅上传到在线转换网站吗？','不建议。订阅通常含授权凭据，优先使用服务商官方接口或可信的本地转换工具。'],
    ['免费节点有哪些安全风险？','可能存在流量记录、广告注入、恶意证书、账号窃取和不稳定等问题。敏感账户与支付不应依赖来源不明的免费代理。'],
    ['代理能隐藏浏览器指纹吗？','不能。代理主要改变网络出口，浏览器指纹、Cookie、时区、字体和设备特征仍可能被识别。'],
    ['为什么不应安装陌生根证书？','根证书可能允许第三方解密 HTTPS 流量。除非明确理解用途和来源，否则不要安装配置要求的未知证书。'],
    ['跨境店铺可以用普通机场节点吗？','普通共享节点适合资料查询，但不适合高价值店铺的长期固定登录。业务环境需要评估独享、静态和地区一致性。'],
    ['如何降低账号异地登录风险？','固定常用地区和设备档案，减少频繁切换，启用多因素认证，保存恢复代码，并定期检查登录记录。'],
    ['代理开启后支付安全吗？','代理不等于支付安全。支付时确认网址与证书，避免使用不可信节点和公共 Wi-Fi，并优先让本地支付网站直连。']
  ]},
  {title:'家庭、设备与软路由',items:[
    ['不限设备和不限 IP 是一回事吗？','不是。设备数、同时连接数、并发公网 IP 和连接数是不同限制，应查看服务条款中的具体定义。'],
    ['软路由算一个设备还是多个设备？','服务端可能只看到一个公网出口，也可能按连接数或设备特征限制，具体取决于服务规则。'],
    ['家庭共享需要多少流量？','应统计电视 4K、手机视频、云盘、电脑更新和游戏补丁。家庭后台任务较多，不能简单用单人流量乘人数。'],
    ['手机开代理后找不到打印机怎么办？','为局域网网段设置直连或 Bypass Local Network，并确认 TUN 没有接管打印机和路由器地址。'],
    ['OpenClash 和终端客户端怎么选？','全屋无感使用适合软路由；只有少数设备需要时，终端客户端更容易维护和排错。'],
    ['软路由开启后全家断网如何恢复？','准备一个不经过代理的管理设备或旁路入口，关闭代理插件，恢复默认 DNS 和路由，再检查配置。'],
    ['异地家人可以共享同一订阅吗？','先核对并发 IP 和家庭共享条款。异地使用会增加公网 IP 数，也可能触发账号限制。'],
    ['电视看 4K 会影响其他设备吗？','可能。可以设置带宽优先级、错开大型下载，并选择持续吞吐稳定的节点，而不是只追求测速峰值。']
  ]}
];
---
<BaseLayout title="问题库帮助" description="ClashShop 常见问题库，解答机场订阅、线路类型、优惠码、客户端下载、推荐排序和评测标准等问题。">
  <div class="shell section faq-page"><Breadcrumbs items={[{label:'首页',href:'/'},{label:'问题库帮助'}]} /><header><p class="eyebrow">KNOWLEDGE BASE</p><h1>问题库帮助</h1><p>按主题整理机场订阅、线路协议、客户端、故障、流媒体、AI 与家庭网络问题。答案为本站原创整理，不替代服务商实时条款。</p></header><nav class="faq-categories" aria-label="FAQ 分类">{groups.map(group=><a href={`#${group.title}`}>{group.title}<small>{group.items.length}</small></a>)}</nav>{groups.map((group,groupIndex)=><section class="faq-group" id={group.title}><div class="faq-group-title"><p>FAQ CATEGORY</p><h2>{group.title}</h2><span>{group.items.length} 个问题</span></div><div class="faq-list">{group.items.map(([question,answer],index)=><details open={groupIndex===0&&index===0}><summary>{question}<span>＋</span></summary><p>{answer}</p></details>)}</div></section>)}<div class="faq-actions"><a class="button button-secondary" href="/tools/">查看工具汇总</a></div></div>
</BaseLayout>
<style>
  .faq-page{max-width:980px}.faq-page>header{margin:28px 0 26px}.faq-page h1{margin:8px 0;font-size:clamp(2.4rem,6vw,4rem)}.faq-page>header>p:last-child{color:#64748b;font-size:1.05rem}.faq-categories{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:42px}.faq-categories a{display:flex;justify-content:space-between;border:1px solid #dce7ee;border-radius:12px;padding:12px 14px;background:#f7fafb;text-decoration:none;font-size:.82rem;font-weight:800}.faq-categories small{color:#0284c7}.faq-group{scroll-margin-top:90px;margin:44px 0}.faq-group-title{display:grid;grid-template-columns:1fr auto;align-items:end;margin-bottom:16px}.faq-group-title p{grid-column:1/-1;margin:0;color:#0284c7;font-size:.68rem;font-weight:900}.faq-group-title h2{margin:2px 0;font-size:1.65rem}.faq-group-title span{color:#64748b;font-size:.75rem}.faq-list{display:grid;gap:12px}.faq-list details{border:1px solid #dce7ee;border-radius:15px;padding:0 20px;background:#fff;box-shadow:0 8px 24px rgba(30,67,91,.05)}.faq-list summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:19px 0;cursor:pointer;font-size:1.03rem;font-weight:800;list-style:none}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{color:#0284c7;font-size:1.25rem}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list details p{margin:0;border-top:1px solid #e5edf2;padding:18px 0 22px;color:#64748b;line-height:1.8}.faq-actions{display:flex;gap:12px;margin-top:24px}@media(max-width:720px){.faq-categories{grid-template-columns:repeat(2,1fr)}}
</style>
